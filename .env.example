# Match the image name printed by docker load / docker images.
UNIMRCP_IMAGE=local/unimrcp-http:1.8.0

# With network_mode: host, 127.0.0.1 refers to the Linux server.
# Replace these URLs if ASR/TTS runs on another machine.
UNIMRCP_HTTP_ASR_URL=http://127.0.0.1:8887/v1/asr/upload
UNIMRCP_HTTP_TTS_URL=http://127.0.0.1:8889/api/v1/tts

# Set these after rebuilding the streaming-capable image. Nonempty values enable
# streaming for that resource and take precedence over the HTTP URLs above.
# On the existing server, the model ports are ASR 5004 and TTS 5005.
UNIMRCP_STREAM_ASR_URL=
UNIMRCP_STREAM_TTS_URL=
# UNIMRCP_STREAM_ASR_URL=ws://127.0.0.1:5004/v1/asr/stream
# UNIMRCP_STREAM_TTS_URL=http://127.0.0.1:5005/api/v1/tts/stream

# UniMRCP's SIP/RTP IP and ports are set in conf/unimrcpserver-http.xml.
# For remote FreeSWITCH clients, set properties/ip to a reachable server NIC IP.
