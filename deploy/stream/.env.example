# Actual image tag inside unimrcp-http-20261008.tar (20061008, not 20261008).
UNIMRCP_IMAGE=unimrcp-http:20061008

# With host networking, 127.0.0.1 is the Linux server running this container.
UNIMRCP_STREAM_ASR_URL=ws://127.0.0.1:5004/v1/asr/stream
UNIMRCP_STREAM_TTS_URL=http://127.0.0.1:5005/api/v1/tts/stream

# SIP 8061, MRCP 1545, RTSP 1555, RTP 25200-25300 are configured in
# conf/unimrcpserver-http.xml. Set properties/ip there for remote clients.
